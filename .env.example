# ==================== Frontend ====================
VITE_REACT_APP_TITLE=派简历
VITE_PORT=5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8084
VITE_APP_PUBLIC_URL=https://resume.paicoding.com
VITE_SUPPORT_EMAIL=
VITE_OPERATOR_NAME=
VITE_AI_PROVIDER_NAME=
VITE_AI_PROVIDER_PRIVACY_URL=

# ==================== Backend ====================
APP_ENV=development
APP_TIME_ZONE=Asia/Shanghai
APP_PUBLIC_URL=https://resume.paicoding.com
SERVER_PORT=8084
FORWARD_HEADERS_STRATEGY=none
# 小规模灰度的连接池与请求线程上限；生产可按监控结果逐步调整。
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SERVER_TOMCAT_THREADS_MAX=48
SERVER_TOMCAT_THREADS_MIN_SPARE=4
SERVER_TOMCAT_MAX_CONNECTIONS=256
SERVER_TOMCAT_ACCEPT_COUNT=32
REFRESH_COOKIE_NAME=pai_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_MAX_AGE_SECONDS=604800
# 派聪明服务号扫码登录：AppSecret/access_token 继续只由 paicoding 持有。
PAICONGMING_WECHAT_LOGIN_ENABLED=false
PAICONGMING_WECHAT_GATEWAY_BASE_URL=
PAICONGMING_WECHAT_GATEWAY_QR_PATH=/api/internal/pairesume/wechat/qrcodes
PAICONGMING_WECHAT_BRIDGE_SECRET=
PAICONGMING_WECHAT_APP_ID=
PAICONGMING_WECHAT_SCENE_PREFIX=pr_
PAICONGMING_WECHAT_CHALLENGE_TTL_SECONDS=300
PAICONGMING_WECHAT_BRIDGE_CLOCK_SKEW_SECONDS=300
PAICONGMING_WECHAT_BRIDGE_REPLAY_TTL_SECONDS=600
PAICONGMING_WECHAT_CHALLENGE_CREATE_MINUTE_LIMIT=10
# paicoding 侧还需用同一共享密钥开启 PAIRESUME_WECHAT_BRIDGE_*；
# 派简历进程不保存派聪明 AppSecret 或 access_token。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,http://localhost:4173,http://127.0.0.1:4173,http://localhost:63342,http://127.0.0.1:63342,http://[::1]:5173,http://[::1]:5175,http://[::1]:4173
DEV_ACCOUNT_EMAIL=test@example.com
DEV_ACCOUNT_PASSWORD=Test123456
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=Admin123456

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pai_resume
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_USE_SSL=false
MYSQL_REQUIRE_SSL=false
MYSQL_VERIFY_SERVER_CERTIFICATE=false
# 仅供生产激活脚本调用备份；不属于应用 datasource。
PAIRESUME_BACKUP_MYSQL_USERNAME=root
PAIRESUME_BACKUP_MYSQL_SOCKET=/var/lib/mysql/mysql.sock

# 生产环境使用独立的数据库迁移账号；应用运行账号不应具备 DDL 权限
FLYWAY_ENABLED=true
FLYWAY_USERNAME=root
FLYWAY_PASSWORD=your_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT（请替换为随机 Base64 字符串，至少 32 字节）
JWT_SECRET=
JWT_ISSUER=pai-resume
JWT_AUDIENCE=pai-resume-web
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# 验证码 HMAC 密钥（必须与 JWT_SECRET 不同，至少 32 字符）
VERIFICATION_CODE_SECRET=
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_EMAIL_HOURLY_LIMIT=5
VERIFICATION_CODE_IP_HOURLY_LIMIT=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_EMAIL_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_ATTEMPTS=100
VIP_INVITE_RATE_LIMIT_WINDOW_SECONDS=900
VIP_INVITE_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
VIP_INVITE_RATE_LIMIT_IP_ATTEMPTS=50
# 未登录邀请码领取凭证默认 10 分钟；失败/过期记录保留 30 天后批量清理，已兑换记录永久保留。
VIP_INVITE_CLAIM_TTL_SECONDS=600
VIP_INVITE_CLAIM_RETENTION_DAYS=30

# 简历市场付费定价范围，单位分；免费公开必须为 0。
# 用户投稿市场总开关默认关闭；不影响官方精选或历史已购权益读取。
MARKETPLACE_ENABLED=false
MARKETPLACE_MIN_PRICE_CENTS=100
MARKETPLACE_MAX_PRICE_CENTS=99900
MARKETPLACE_REPORT_DAILY_IP_LIMIT=10
MARKETPLACE_REPORT_DUPLICATE_WINDOW_HOURS=24

# 人工简历精修。默认发送到 MAIL_FROM；仅需改用其他私密收件箱时填写此项。
RESUME_REVIEW_RECIPIENT_EMAIL=
RESUME_REVIEW_MESSAGE_ID_DOMAIN=resume.paicoding.com
RESUME_REVIEW_MAIL_OUTBOX_MAX_ATTEMPTS=10
# PDF 提交受账号/IP 双预算约束。
RESUME_REVIEW_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
RESUME_REVIEW_UPLOAD_RATE_LIMIT_ACCOUNT_ATTEMPTS=20
RESUME_REVIEW_UPLOAD_RATE_LIMIT_IP_ATTEMPTS=200
RESUME_REVIEW_PAYMENT_ORDER_EXPIRE_MINUTES=30
# 真实微信下单、回调、查单、迟到支付、邮件和退款全部留证后才可改为 true。
RESUME_REVIEW_PAYMENT_ACCEPTANCE_CONFIRMED=false

# 简历照片固定使用私有阿里云 OSS，不存在功能开关。以下四项在所有环境均为启动必填项；
# 建议使用照片专用 RAM 用户，仅授权 staging/objects 两个前缀。数据库只保存照片资产 ID。
RESUME_PHOTO_OSS_STAGING_PREFIX=pairesume/resume-photo/staging/
RESUME_PHOTO_OSS_OBJECT_PREFIX=pairesume/resume-photo/objects/
RESUME_PHOTO_OSS_UPLOAD_URL_TTL_MINUTES=10
RESUME_PHOTO_OSS_ACCESS_URL_TTL_MINUTES=60
RESUME_PHOTO_OSS_MAX_BYTES=3145728
RESUME_PHOTO_OSS_MAX_DIMENSION=4096
RESUME_PHOTO_OSS_MAX_PIXELS=16000000
RESUME_PHOTO_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
RESUME_PHOTO_UPLOAD_RATE_LIMIT_ACCOUNT_ATTEMPTS=20
RESUME_PHOTO_UPLOAD_RATE_LIMIT_IP_ATTEMPTS=200
# 仅生产环境强制为 true；完成真实配置与验收前不得虚假确认。

# 会员与简历市场支付。默认 disabled；mock 仅允许 development/test，生产请使用 wechat-native。
PAYMENT_PROVIDER=mock
# 旧总开关仅用于兼容检查，必须保持 false；若设为 true，应用会拒绝启动，防止误开两条业务线。
PAYMENT_ACCEPT_NEW_ORDERS=false
# 两条业务线独立、默认关闭。可以只开放会员支付，保持用户付费简历市场关闭。
MEMBERSHIP_PAYMENT_ACCEPT_NEW_ORDERS=false
MARKETPLACE_PAYMENT_ACCEPT_NEW_ORDERS=false
PAYMENT_ORDER_EXPIRE_MINUTES=15
# 会员支付订单必须保留 30 分钟；方案期限和价格由 membership_plan 管理。
MEMBERSHIP_ORDER_EXPIRE_MINUTES=30
# 当前默认不抽成；产品确认平台服务费前保持 0。
MARKETPLACE_PLATFORM_FEE_BPS=0
# 作者收益先冻结，默认 7 天；冻结期内会持续对账，退款可直接冲销。
MARKETPLACE_EARNING_HOLD_DAYS=7
# 冻结期内已支付订单的稀疏主动查单间隔；到期放款前仍会强制完成最终查单。
MARKETPLACE_PAID_RECONCILIATION_INTERVAL_MINUTES=360
# 到期最终验真失败时的重试间隔，避免支付平台异常导致每个调度 tick 都查单。
MARKETPLACE_PAID_DUE_RECONCILIATION_RETRY_MINUTES=5
PAYMENT_MOCK_AUTO_PAY=true
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
# 支持 PEM、PEM 的 Base64，或 classpath:/file: 资源路径；不要提交真实私钥。
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://resume.paicoding.com/api/public/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://resume.paicoding.com/api/public/payments/wechat/refund-notify

# 后端 AI（OpenAI-Compatible）
# 后台 AI、照片 OSS、微信支付敏感字段的 AES-256-GCM 主密钥：openssl rand -base64 32
AI_PROVIDER_MASTER_KEY=
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-5.1
AI_ANALYSIS_MODEL=glm-4.5-air
FIELD_OPTIMIZE_PROMPTS_FILE=config/field-optimize-prompts.yml

# 邮件
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_auth_code
MAIL_FROM=your_email@qq.com
MAIL_TEST_CONNECTION=false
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false
MAIL_SSL_CHECK_SERVER_IDENTITY=true
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# 生产环境必须关闭公开 API 文档
SPRINGDOC_ENABLED=true
