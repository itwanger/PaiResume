APP_ENV=production
DEPLOY_STAGE=free
APP_TIME_ZONE=Asia/Shanghai
APP_PUBLIC_URL=https://resume.paicoding.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://resume.paicoding.com
# 仅供稳定生产预检定位候选 release，不是应用运行时项目根目录。
RELEASE_ROOT=/home/www/pairesume/current
FIELD_OPTIMIZE_PROMPTS_FILE=/home/www/pairesume/current/config/field-optimize-prompts.yml
# 生产预检固定要求仅监听本机 127.0.0.1:8084，与 Nginx 和健康检查保持一致。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8084
# 小规模知识星球灰度资源上限；上线后只按真实监控逐步调整。
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SERVER_TOMCAT_THREADS_MAX=48
SERVER_TOMCAT_THREADS_MIN_SPARE=4
SERVER_TOMCAT_MAX_CONNECTIONS=256
SERVER_TOMCAT_ACCEPT_COUNT=32
VITE_SUPPORT_EMAIL=replace-me-with-private-support-email
VITE_OPERATOR_NAME=replace-me-with-registered-operator
VITE_AI_PROVIDER_NAME=replace-me-with-ai-provider-name
VITE_AI_PROVIDER_PRIVACY_URL=https://replace-me.example.invalid/privacy
FORWARD_HEADERS_STRATEGY=native
REFRESH_COOKIE_SECURE=true
SPRINGDOC_ENABLED=false

# 知识星球灰度必须启用派聪明扫码注册/登录；缺少真实桥接参数时拒绝发布。
PAICONGMING_WECHAT_LOGIN_ENABLED=true
PAICONGMING_WECHAT_GATEWAY_BASE_URL=https://paicoding.com
PAICONGMING_WECHAT_GATEWAY_QR_PATH=/api/internal/pairesume/wechat/qrcodes
PAICONGMING_WECHAT_BRIDGE_SECRET=replace-with-independent-bridge-secret-at-least-32-bytes
PAICONGMING_WECHAT_APP_ID=wxreplacewithrealid
PAICONGMING_WECHAT_SCENE_PREFIX=pr_
# 完成 deploy/checklists/planet-core-acceptance.md 并留证后才能改为 true。
PLANET_CORE_ACCEPTANCE_CONFIRMED=false
# 邀请码领取凭证 10 分钟有效；失败/过期记录默认保留 30 天，已兑换记录不清理。
VIP_INVITE_CLAIM_TTL_SECONDS=600
VIP_INVITE_CLAIM_RETENTION_DAYS=30

JWT_SECRET=replace-with-at-least-32-random-bytes
VERIFICATION_CODE_SECRET=replace-with-another-at-least-32-random-bytes

# 只维护一个 pai_resume 账号，应用与 Flyway 共用；不拆迁移或备份账号。
# 预检固定数据库为本机 127.0.0.1:3306/pai_resume，并要求两组用户名和密码完全相同。
# 账号强制 TLS、最多 12 个连接，且只授权 pai_resume.*。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pai_resume
# deploy/bootstrap-production-env.sh 从 /etc/pai-resume/mysql-app.env 安全复制凭据。
MYSQL_SHARED_ACCOUNT_CONFIRMED=true
MYSQL_USERNAME=pai_resume
MYSQL_PASSWORD=replace-with-generated-pai-resume-password
FLYWAY_USERNAME=pai_resume
FLYWAY_PASSWORD=replace-with-generated-pai-resume-password
# 数据库备份由生产机 root 通过本地 Unix socket 执行，不使用上述应用变量，
# 也不要把 MySQL root 密码写入本环境文件。
MYSQL_USE_SSL=true
MYSQL_REQUIRE_SSL=true
MYSQL_VERIFY_SERVER_CERTIFICATE=true
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# 发布激活前的数据库备份固定使用本机 root + Unix socket，不读取应用密码。
PAIRESUME_BACKUP_MYSQL_USERNAME=root
PAIRESUME_BACKUP_MYSQL_SOCKET=/var/lib/mysql/mysql.sock

REDIS_HOST=127.0.0.1
REDIS_PORT=6388
REDIS_PASSWORD=replace-me
# 与其他项目复用同一个 Redis 进程，但使用独立逻辑库和统一 key namespace。
REDIS_DATABASE=1
REDIS_KEY_PREFIX=pairesume:prod:

MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=replace-me
MAIL_TEST_CONNECTION=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false

# 人工简历精修默认发送到 MAIL_FROM；仅需改用其他私密收件箱时填写此项。
RESUME_REVIEW_RECIPIENT_EMAIL=
RESUME_REVIEW_MESSAGE_ID_DOMAIN=resume.paicoding.com
# 自动投递最多尝试 10 次；确定性附件校验失败会立即停止自动重试。
RESUME_REVIEW_MAIL_OUTBOX_MAX_ATTEMPTS=10
# authorize/complete 按动作分别计数，并同时执行账号/IP 双预算。
RESUME_REVIEW_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
RESUME_REVIEW_UPLOAD_RATE_LIMIT_ACCOUNT_ATTEMPTS=20
RESUME_REVIEW_UPLOAD_RATE_LIMIT_IP_ATTEMPTS=200
# 简历照片固定使用私有 OSS，不存在功能开关；缺少任一必填配置时应用拒绝启动。
# 可复用同一私有 Bucket，但 RAM 权限必须覆盖照片专用前缀。图片由浏览器直传，
# 数据库只保存资产 ID；读取使用短期签名 URL，不绑定公开 CDN。
RESUME_PHOTO_OSS_STAGING_PREFIX=pairesume/resume-photo/staging/
RESUME_PHOTO_OSS_OBJECT_PREFIX=pairesume/resume-photo/objects/
RESUME_PHOTO_OSS_UPLOAD_URL_TTL_MINUTES=10
RESUME_PHOTO_OSS_ACCESS_URL_TTL_MINUTES=60
RESUME_PHOTO_OSS_MAX_BYTES=3145728
RESUME_PHOTO_OSS_MAX_DIMENSION=4096
RESUME_PHOTO_OSS_MAX_PIXELS=16000000
RESUME_PHOTO_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
RESUME_PHOTO_UPLOAD_RATE_LIMIT_ACCOUNT_ATTEMPTS=20
RESUME_PHOTO_UPLOAD_RATE_LIMIT_IP_ATTEMPTS=200
RESUME_REVIEW_PAYMENT_ORDER_EXPIRE_MINUTES=30
RESUME_REVIEW_PAYMENT_ACCEPTANCE_CONFIRMED=false

# 当前仍是启动环境配置；管理后台加密配置实现后再增加显式配置来源选择。
AI_API_KEY=replace-me
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_ANALYSIS_MODEL=deepseek-chat

PAYMENT_PROVIDER=wechat-native
PAYMENT_ACCEPT_NEW_ORDERS=false
MEMBERSHIP_PAYMENT_ACCEPT_NEW_ORDERS=false
MARKETPLACE_PAYMENT_ACCEPT_NEW_ORDERS=false
SHOWCASE_PAYMENT_ACCEPT_NEW_ORDERS=false
MARKETPLACE_ENABLED=false
# 会员订单固定保留 30 分钟；方案期限和价格由 membership_plan 管理并写入订单快照。
MEMBERSHIP_ORDER_EXPIRE_MINUTES=30
MEMBERSHIP_PAYMENT_ACCEPTANCE_CONFIRMED=false
MARKETPLACE_PAYMENT_ACCEPTANCE_CONFIRMED=false
MARKETPLACE_GOVERNANCE_DUTY_CONFIRMED=false
PAYMENT_ACCEPTANCE_ENVIRONMENT_CONFIRMED=false

WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://resume.paicoding.com/api/public/payments/wechat/notify
