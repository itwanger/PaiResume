APP_ENV=production
DEPLOY_STAGE=free
APP_TIME_ZONE=Asia/Shanghai
APP_PUBLIC_URL=https://resume.paicoding.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://resume.paicoding.com
APP_PROJECT_ROOT=/opt/pai-resume/current
FIELD_OPTIMIZE_PROMPTS_FILE=/opt/pai-resume/current/config/field-optimize-prompts.yml
VITE_SUPPORT_EMAIL=replace-me-with-private-support-email
VITE_OPERATOR_NAME=replace-me-with-registered-operator
VITE_AI_PROVIDER_NAME=replace-me-with-ai-provider-name
VITE_AI_PROVIDER_PRIVACY_URL=https://replace-me.example.invalid/privacy
FORWARD_HEADERS_STRATEGY=native
REFRESH_COOKIE_SECURE=true
SPRINGDOC_ENABLED=false

# 派聪明服务号扫码登录。AppSecret/access_token 只保留在 paicoding。
PAICONGMING_WECHAT_LOGIN_ENABLED=true
PAICONGMING_WECHAT_GATEWAY_BASE_URL=https://paicoding.com
PAICONGMING_WECHAT_GATEWAY_QR_PATH=/api/internal/pairesume/wechat/qrcodes
PAICONGMING_WECHAT_BRIDGE_SECRET=replace-with-an-independent-at-least-32-random-bytes
PAICONGMING_WECHAT_APP_ID=replace-me-with-paicongming-app-id
PAICONGMING_WECHAT_SCENE_PREFIX=pr_
# 邀请码领取凭证 10 分钟有效；失败/过期记录默认保留 30 天，已兑换记录不清理。
VIP_INVITE_CLAIM_TTL_SECONDS=600
VIP_INVITE_CLAIM_RETENTION_DAYS=30

JWT_SECRET=replace-with-at-least-32-random-bytes
VERIFICATION_CODE_SECRET=replace-with-another-at-least-32-random-bytes

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pai_resume
MYSQL_USERNAME=pai_resume_app
MYSQL_PASSWORD=replace-me
FLYWAY_USERNAME=pai_resume_migrator
FLYWAY_PASSWORD=replace-me
MYSQL_USE_SSL=true
MYSQL_REQUIRE_SSL=true
MYSQL_VERIFY_SERVER_CERTIFICATE=true
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=replace-me
MAIL_TEST_CONNECTION=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

# 人工简历精修：固定收件邮箱和沉默王二公众号关注奖励桥。
RESUME_REVIEW_RECIPIENT_EMAIL=replace-me-with-private-review-mailbox
RESUME_REVIEW_MESSAGE_ID_DOMAIN=resume.paicoding.com
RESUME_REVIEW_PAID_ACCEPT_NEW_ORDERS=false
RESUME_REVIEW_PAYMENT_ORDER_EXPIRE_MINUTES=30
RESUME_REVIEW_FOLLOW_OFFICIAL_ACCOUNT_NAME=沉默王二
RESUME_REVIEW_FOLLOW_QR_CODE_URL=https://replace-me.example.invalid/wechat-follow-qr.png
RESUME_REVIEW_FOLLOW_BRIDGE_ENABLED=false
RESUME_REVIEW_FOLLOW_BRIDGE_HMAC_SECRET=replace-with-at-least-32-random-bytes
RESUME_REVIEW_PAYMENT_ACCEPTANCE_CONFIRMED=false

AI_API_KEY=replace-me
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_ANALYSIS_MODEL=deepseek-chat

PAYMENT_PROVIDER=disabled
PAYMENT_ACCEPT_NEW_ORDERS=false
MEMBERSHIP_PAYMENT_ACCEPT_NEW_ORDERS=false
MARKETPLACE_PAYMENT_ACCEPT_NEW_ORDERS=false
MARKETPLACE_ENABLED=false
# 年费会员订单固定保留 30 分钟，每笔权益固定为 365 天并写入订单快照。
MEMBERSHIP_ORDER_EXPIRE_MINUTES=30
MEMBERSHIP_PAYMENT_DAYS=365
MEMBERSHIP_PAYMENT_ACCEPTANCE_CONFIRMED=false
MARKETPLACE_PAYMENT_ACCEPTANCE_CONFIRMED=false
MARKETPLACE_GOVERNANCE_DUTY_CONFIRMED=false
PAYMENT_ACCEPTANCE_ENVIRONMENT_CONFIRMED=false

WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://resume.paicoding.com/api/public/payments/wechat/notify
