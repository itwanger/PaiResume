[Unit]
Description=PaiResume daily MySQL backup
After=mysqld.service

[Service]
Type=oneshot
User=root
Group=root
Environment="MYSQL_DATABASE=pai_resume"
Environment="MYSQL_USERNAME=root"
Environment="MYSQL_SOCKET=/var/lib/mysql/mysql.sock"
Environment="BACKUP_DIR=/var/backups/pai-resume"
Environment="BACKUP_LOCK_FILE=/var/backups/pai-resume/.mysql-backup.lock"
Environment="BACKUP_RETENTION_DAYS=30"
ExecStartPre=/usr/bin/test -S /var/lib/mysql/mysql.sock
ExecStart=/home/www/pairesume/bin/backup-mysql.sh
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pai-resume-mysql-backup
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
CPUQuota=20%
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
OOMScoreAdjust=500
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/backups/pai-resume
